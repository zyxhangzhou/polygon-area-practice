# 复制为仓库根目录下的 .env（已被 .gitignore 排除），按需修改。
# 本地开发 `npm run dev` 会读取它；测试不读取它；Docker Compose 只用它做端口与日志级别的变量替换。

# 后端连接的数据库（本地开发：连接 `docker compose up -d db` 启动的 Postgres）
DATABASE_URL=postgres://postgres:postgres@localhost:55432/polygon

# 后端监听端口
PORT=3000

# 前端开发服务器（Vite）端口；被占用时修改（如 WSL 下 5173 被 Windows 保留时可用 4173）
WEB_DEV_PORT=5173

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 服务前面可信的反向代理层数（限流按客户端 IP 计数）；本地直连保持 0
TRUST_PROXY_HOPS=0

# Docker Compose 映射到宿主机的端口（端口被占用时修改）
DB_PORT=55432
APP_PORT=3000

# 测试数据库 TEST_DATABASE_URL：测试不读本文件，写在这里无效。
# 默认 postgres://postgres:postgres@localhost:55432/polygon_test；需要修改时在 shell 中设置：
#   TEST_DATABASE_URL=postgres://postgres:postgres@localhost:<端口>/polygon_test npm test
